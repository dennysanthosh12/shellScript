

CREATE COMPUTE MODULE postUpdate_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE ref REFERENCE TO InputRoot.JSON.Data.Item[1];
		WHILE LASTMOVE(ref) DO
		  PASSTHRU('INSERT INTO EISUATSUPPORT.APIDETAILS (API_NAME,INTEGRATION_NODE,INTEGRATION_SERVER,SERVER_IP,API_STATE,DEPLOYED_DATE) VALUES (?,?,?,?,?,?)' , ref.ApiName,ref.IntegrationNode,ref.IntegrationServer,ref.ServerIP,ref.ApiState,COALESCE(CAST(ref.DeployedDate AS DATE FORMAT 'yyyy-MM-dd'),0000-00-00)) ;
		  MOVE ref NEXTSIBLING;
		END WHILE;
		RETURN TRUE;
	END;

END MODULE;
